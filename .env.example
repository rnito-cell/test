# Google OAuth（Google Cloud Console で作成）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/callback

# サインイン後に戻るフロントURL（Vite のポートと一致させる）
WEB_ORIGIN=http://localhost:5173

# Business Profile（接続後 /api/accounts と /api/locations で確認できる）
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

PORT=8787

# 返信下書き（日本語レビューは日本語、英語は英語）
ANTHROPIC_API_KEY=
